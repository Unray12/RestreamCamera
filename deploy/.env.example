# RestreamCamera — copy to .env and edit before `docker compose up -d`.

# Credentials for the web UI and API.
RC_ADMIN_USER=admin
RC_ADMIN_PASSWORD=change-me-please

# LAN IP or DNS name that VMS / browsers use to reach this machine.
# Leave as localhost when everything runs on one workstation.
RC_PUBLIC_HOST=192.168.1.10

# Optional: pin the encryption key for source URLs and camera passwords.
# Without it a 32-byte key is generated once and stored in data/master.key.
# Generate with:  openssl rand -base64 32
# RC_MASTER_KEY=

# Optional tuning.
# RC_LOG_LEVEL=info
# RC_RECONCILE_INTERVAL=5s
# RC_VERSION=dev
