# RestreamCamera — copy to .env and edit before `docker compose up -d`.

# Credentials for the web UI and API.
RC_ADMIN_USER=admin
RC_ADMIN_PASSWORD=admin

# LAN IP or DNS name that VMS / browsers use to reach this machine.
# Leave as localhost when everything runs on one workstation.
RC_PUBLIC_HOST=192.168.1.10

# Optional: pin the encryption key for source URLs and camera passwords.
# Without it a 32-byte key is generated once and stored in data/master.key.
# Generate with:  openssl rand -base64 32
# RC_MASTER_KEY=

# Optional tuning.
# RC_LOG_LEVEL=info
# RC_RECONCILE_INTERVAL=5s

# Optional: move every port this stack uses. Needed when the machine already
# runs another MediaMTX (or another RestreamCamera stack) on the defaults
# below — uncomment and pick a free port for each one, no compose/mediamtx.yml
# edits needed. Remember to also update RC_PUBLIC_* ports if you expose them
# behind a different host/NAT, and give the second stack its own data dir.
# RC_HTTP_PORT=8080
# RC_RTSP_PORT=8554
# RC_HLS_PORT=8888
# RC_WEBRTC_PORT=8889
# RC_WEBRTC_UDP_PORT=8189
# RC_SRT_PORT=8890
# RC_MEDIA_API_PORT=9997
# RC_MEDIA_METRICS_PORT=9998

# Image của project: build bằng `docker compose build api`, hoặc pull bằng
# `docker-compose.deploy.yml` (không cần source). Một tag cố định, push chồng
# lên mỗi lần release — không tạo tag theo từng version.
# RC_IMAGE=unray/restreamcamera-api
# RC_TAG=latest

# Version embedded into the binary, printed by `restreamd version`.
# RC_VERSION=dev
